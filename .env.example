# =============================================
# FATURAAO — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores
# NUNCA faças commit do ficheiro .env com valores reais!
# =============================================

# ── Supabase (database + auth) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NextAuth ──────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ── Super Admin ───────────────────────────────
# Email do utilizador com acesso de plataforma
SUPER_ADMIN_EMAIL=admin@faturaao.ao

# ── Cloud Storage (S3 / Abacus.AI) ───────────
AWS_BUCKET_NAME=your-bucket
AWS_FOLDER_PREFIX=your-folder/
AWS_REGION=us-east-1

# ── PDF Generation (AbacusAI) ─────────────────
ABACUSAI_API_KEY=your-api-key

# ── Upstash Redis (Rate Limiting & Cache) ─────
# Obter em: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ── Resend (Email transacional) ───────────────
# Obter em: https://resend.com
RESEND_API_KEY=re_your-resend-api-key

# ── Ambiente ──────────────────────────────────
NODE_ENV=development
